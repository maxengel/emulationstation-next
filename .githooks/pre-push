#!/bin/bash
# pre-push guard for the EmulationStation fork (maxengel/emulationstation-next).
#
# Two jobs, the same as the distribution fork's .githooks/pre-push:
#   1. a pr/* branch must not differ from upstream/master in a personal path --
#      the agent context files that live on test/qa-integration and the
#      feature branches cut from it;
#   2. every pushed branch is scanned for credential-shaped lines.
#
# Enable once per clone (shared by every worktree), pointing at the worktree
# that always holds test/qa-integration -- this file lives on that branch:
#   git config core.hooksPath ~/Development/emulationstation-next.worktrees/qa-integration/.githooks
# The absolute path matters: a relative core.hooksPath resolves against the
# worktree being pushed from, and a correctly built pr/* branch has no
# .githooks/ at all, so the guard would silently not run. A path naming a
# directory that does not exist runs nothing and says nothing either --
# check `ls "$(git config core.hooksPath)"` lists pre-push.
#
# What each guard reads, and why (#151 PL-08, 2026-09-13):
#   - The secret scan reads every line ADDED by every commit in the push, not
#     the files at the pushed tip. A tip-only scan let a secret that one
#     commit added and a later one removed travel unread; the history keeps it.
#   - pr/* is decided from the REMOTE ref -- the name the push creates -- not
#     the local branch. `git push origin feature/x:refs/heads/pr/x` used to
#     skip the personal-path guard entirely.
#   - A pr/* push with no upstream/master, or whose base diff fails, is
#     refused rather than passed on an empty list.
# Proven in a scratch repo (a bare remote per hook, hooksPath pointing here;
# the "secret" is sixteen letters that spell nothing after devpassword=):
#   feature/x: base; add devpassword=<16 letters> to src/x.txt; remove it again
#   feature/y: base; add CLAUDE.md
#   old hook   git push r1 feature/x                     -> pushed (tip is clean)
#              git push r1 feature/y:refs/heads/pr/y     -> pushed (local name not pr/*)
#   this hook  git push r2 feature/x
#     pre-push: feature/x -> feature/x: a commit in this push adds a credential-shaped line:
#         <sha>:src/x.txt: +[REDACTED]          (the whole match is redacted)
#              git push r2 feature/y:refs/heads/pr/y
#     pre-push: feature/y -> pr/y differs from upstream/master in a personal path: CLAUDE.md
#              git remote remove upstream; git push r2 feature/y:refs/heads/pr/y
#     pre-push: feature/y -> pr/y: no upstream/master to compare against; git fetch upstream first
#              git push r2 feature/y                     -> pushed (not pr/*, no secret)
#   Each refusal ends: pre-push: refused. ...   and exits 1.
# Its own test is .githooks/pre-push-test (#307 PL-078): a scratch repository,
# the stdin lines git would send, and a case for each shape above plus a root
# commit, a rename that adds a line, a remote tip this clone lacks and a first
# push to a second remote, a binary under build-tests/ on pr/*, and a clone
# whose only master is the fork's. Run it after any change here; PASS or FAIL.
set -u
PERSONAL_PATTERNS=(
  'CLAUDE.md'
  'AGENTS.md'
  '.claude/'
  '.githooks/'
  'build-tests/'   # the unit tests' build directory and the binary a build leaves there (#308 F-PB-19)
)
SECRET_PATTERNS='devpassword=[A-Za-z0-9._%-]{4,}|[?&]y=[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY|"(access|refresh)_token" *: *"[A-Za-z0-9._-]{16,}|sk-[A-Za-z0-9_-]{24,}|(API_?KEY|TOKEN|SECRET|PASSWORD|PASSWD)[A-Z_]* *[:=] *["'"'"']?[A-Za-z0-9+/=_-]{16,}'

remote_name="${1:-}"
hooks_path="$(git config --get core.hooksPath || true)"
case "${hooks_path}" in
  /*) ;;
  *) echo "pre-push: core.hooksPath is relative ('${hooks_path}'); set it absolute: git config core.hooksPath \"\$(git rev-parse --show-toplevel)/.githooks\"" >&2 ;;
esac

status=0
zero=0000000000000000000000000000000000000000
# The upstream here is ROCKNIX/emulationstation-next, whose branch is master:
# found by its URL, not by a remote's name (#308 F-PB-18). origin/master
# used to be the last fallback, and this clone's origin is the fork -- whose
# master may already carry CLAUDE.md, so a pr/* branch cut from it differed
# from it in nothing personal and went through. No ROCKNIX remote with a
# master here, and a pr/* push is refused below.
base_ref=""
for remote in $(git remote); do
  case "$(git remote get-url "${remote}" 2>/dev/null)" in
    *[/:]ROCKNIX/emulationstation-next|*[/:]ROCKNIX/emulationstation-next.git|*[/:]ROCKNIX/emulationstation-next/)
      git rev-parse --verify --quiet "refs/remotes/${remote}/master^{commit}" >/dev/null && { base_ref="${remote}/master"; break; } ;;
  esac
done
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "${local_sha}" = "${zero}" ] && continue      # a deletion
  branch="${local_ref#refs/heads/}"
  dest="${remote_ref#refs/heads/}"
  where="${branch} -> ${dest}"

  # The commits this push sends (#307 PL-078, F-PB-11). Over a remote tip
  # this clone has, remote..local. Otherwise -- a first push, or a tip
  # somebody else pushed that this clone has never fetched -- everything the
  # DESTINATION is not known to hold: every commit not on one of its own
  # remote-tracking refs ("$1" is the remote's name; a bare URL names none,
  # and the whole history is read). This used to be the commits no remote
  # at all had, from the oldest one's parent: a root commit has no parent,
  # so the range did not exist, git log failed into /dev/null and the push
  # went through unread; a tip this clone lacked did the same; and history
  # already on origin went to a second remote unread.
  if [ "${remote_sha}" != "${zero}" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    revs=("${remote_sha}..${local_sha}")
  else
    revs=("${local_sha}" --not "--remotes=${remote_name:-.}")
  fi

  # 2. credential-shaped lines, every branch: every line ADDED by every
  #    commit in the range, not the files at the tip, which a later commit
  #    can have cleaned. Merges are shown against their first parent so a
  #    conflict resolution is read too; a line a merge carries in from a
  #    side branch is then reported twice, which costs nothing. The awk
  #    keeps the commit and file each added line came from; grep decides.
  #    One exemption, as narrow as it reads: a line in a unit test that hands
  #    its string to maskSecrets( is a fixture for the credential mask itself
  #    (fork #177) and is credential-shaped on purpose; anything else in a
  #    test file is still scanned. The second exemption is this guard's own
  #    test: .githooks/pre-push-test builds a scratch repository around a
  #    FAKE= value that is credential-shaped on purpose, and a guard that
  #    refuses its own proof cannot be pushed (2026-09-28, #307 PL-078).
  #    Every class of change that can add a line is read -- a rename with a
  #    line added is R, not M, and --diff-filter=AM let it through unread
  #    (F-PB-12). And a list of commits that cannot be made is a refusal,
  #    not an empty scan: git log's failure used to vanish into /dev/null.
  if ! added="$(git log --format='@@commit %h' -p --no-color --diff-merges=first-parent --diff-filter=ACMRT "${revs[@]}" -- 2>/dev/null)"; then
    echo "pre-push: ${where}: could not list the commits this push sends (git log ${revs[*]} failed); nothing was scanned" >&2
    status=1
    continue
  fi
  hits="$(printf '%s\n' "${added}" \
    | awk 'BEGIN { c = ""; f = "" }
           /^@@commit / { c = substr($0, 10); next }
           /^\+\+\+ b\// { f = substr($0, 7); next }
           /^\+\+\+ / { next }
           /^\+/ { print c ":" f ": " $0 }' \
    | grep -v -E '^[0-9a-f]+:es-app/tests/unit/[A-Za-z0-9]+Tests\.cpp: \+.*maskSecrets\(' \
    | grep -v -E '^[0-9a-f]+:\.githooks/pre-push-test: \+FAKE="' \
    | grep -E "${SECRET_PATTERNS}" | sed -E "s/(${SECRET_PATTERNS})/[REDACTED]/g" | head -5 || true)"
  if [ -n "${hits}" ]; then
    echo "pre-push: ${where}: a commit in this push adds a credential-shaped line:" >&2
    echo "${hits}" | sed 's/^/    /' >&2
    status=1
  fi

  # 1. personal paths, pr/* only -- pr/* as the remote will name it.
  case "${dest}" in pr/*) ;; *) continue ;; esac
  [ -n "${base_ref}" ] || { echo "pre-push: ${where}: no ROCKNIX/emulationstation-next master to compare against (a remote with that URL, fetched); git fetch upstream first" >&2; status=1; continue; }
  if ! changed="$(git diff --name-only "${base_ref}...${local_sha}" 2>/dev/null)"; then
    echo "pre-push: ${where}: git diff ${base_ref}...${local_sha} failed; nothing was compared" >&2; status=1; continue
  fi
  while IFS= read -r f; do
    [ -n "${f}" ] || continue
    for pat in "${PERSONAL_PATTERNS[@]}"; do
      case "${f}" in "${pat}"*|*/"${pat}"*)
        echo "pre-push: ${where} differs from ${base_ref} in a personal path: ${f}" >&2; status=1 ;;
      esac
    done
  done <<< "${changed}"
done
[ "${status}" -eq 0 ] || echo "pre-push: refused. Build pr/* by content from test/qa-integration, naming source paths only." >&2
exit ${status}
